# Prefer `npm run init`: generates two independent secrets without printing them.
PUBLIC_ORIGIN=http://127.0.0.1:8787
HOST=127.0.0.1
PORT=8787
DATA_PATH=./data/gatekeeper.sqlite
# Required: generate independent random values, at least 32 characters each.
MUSE_TOKEN=
DEVICE_TOKEN=

# Optional APNs. Leave all unset to use foreground sync only.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=com.example.gatekeeper
# APNS_PRIVATE_KEY=""
