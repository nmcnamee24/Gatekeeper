# Hosted Rook configuration. Keep real values in a private env file or Railway.
PUBLIC_ORIGIN=http://127.0.0.1:8788
HOST=127.0.0.1
PORT=8788
DATABASE_URL=postgresql://gatekeeper:gatekeeper@127.0.0.1:5432/gatekeeper
# Generate with node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
APPLE_AUDIENCE=
APPLE_BUNDLE_ID=com.noah.gatekeeper
# Apple Sign in key enables authorization-code exchange and account revocation.
APPLE_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=
# Alternatively, a current Apple client-secret JWT may be supplied securely.
# APPLE_CLIENT_SECRET=
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-4.1-mini
AI_MAX_REQUESTS_PER_DAY=20
AI_MAX_REQUESTS_PER_MINUTE=5
AI_GLOBAL_REQUESTS_PER_DAY=500
BETA_ACCESS=true
SUPPORT_EMAIL=
STOREKIT_ENVIRONMENT=Sandbox
STOREKIT_PRODUCT_IDS=
# Required for paid production verification:
# APPLE_APP_ID=
# Optional APNs uses the signed app's topic and Apple push key (not signin key):
# APNS_TOPIC=com.noah.gatekeeper
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_PRIVATE_KEY=

# Scope of the base APNs key; sandbox, production or both (must match Apple).
APNS_ENVIRONMENT=sandbox
# Optional separate topic-scoped production key for TestFlight/App Store.
# APNS_PRODUCTION_KEY_ID=
# APNS_PRODUCTION_TEAM_ID=
# APNS_PRODUCTION_PRIVATE_KEY=
